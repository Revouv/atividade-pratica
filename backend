const express = require("express");
const app = express();
const PORT = 3000;

app.use(express.json());

const USER = "arthur";
const PASS = "abcd";

app.post("/login", (req, res) => {
  const { usuario, senha } = req.body;

  if (!usuario || !senha) {
    return res.status(400).json({ mensagem: "Requisição inválida. Informe usuário e senha." });
  }

  if (usuario === USER && senha === PASS) { return res.status(200).json({ mensagem: "Login realizado com sucesso!" }); } 
  else { return res.status(401).json({ mensagem: "Usuário ou senha inválidos." }); }
});

app.listen(PORT, () => { console.log(`Servidor rodando em http://localhost:${PORT}`);
});
